# .zshrc.darwin
# Mac 用の設定を記述するファイル

###############################################################################
# 環境変数

# Homebrew
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="$HOMEBREW_PREFIX/bin:$PATH"
export PATH="$HOMEBREW_PREFIX/sbin:$PATH"

# my own commands
export PATH="$HOME/commands:$PATH"

# C++ Libraries
export CPLUS_INCLUDE_PATH=$CPLUS_INCLUDE_PATH:$HOMEBREW_PREFIX/include
export CPLUS_INCLUDE_PATH=$CPLUS_INCLUDE_PATH:$HOME/ac-library

# OpenSSL
export PATH="$HOMEBREW_PREFIX/opt/openssl/bin:$PATH"

# Needed to install SciPy on M1 Mac using pip
export OPENBLAS="$HOMEBREW_PREFIX/opt/openblas"

# OpenJDK
export PATH="$HOMEBREW_PREFIX/opt/openjdk/bin:$PATH"

# Homebrew curl
export PATH="$HOMEBREW_PREFIX/opt/curl/bin:$PATH"

###############################################################################

# Remove dotfiles
function remove_dotfiles() {
  /usr/bin/zip --delete $@ "*__MACOSX*" "*.DS_Store"
}
alias undot='remove_dotfiles'

function use_llvm_clang() {
  export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
  export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"
}

# ピリカンと句読点の切り替え (switch-punctuation)
function switch_kotoeri_punctuation() {
  x=$(defaults read com.apple.inputmethod.Kotoeri JIMPrefPunctuationTypeKey)
  if [[ $x == 0 ]] then
    defaults write com.apple.inputmethod.Kotoeri JIMPrefPunctuationTypeKey -int 3
  else
    defaults write com.apple.inputmethod.Kotoeri JIMPrefPunctuationTypeKey -int 0
  fi
  killall -HUP JapaneseIM-RomajiTyping
}
alias swpunc='switch_kotoeri_punctuation'

# iTerm2 shell integration
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# 1Password CLI
test -e $HOME/.config/op/plugins.sh && source $HOME/.config/op/plugins.sh
# Use gh native Keychain authentication while keeping other shell plugins.
unalias gh 2>/dev/null

# brew install / uninstall が成功したら Brewfile を自動で書き出す
# 書き出し先: config.yaml の homebrew.brewfile、なければ ~/Brewfile
function brew() {
  local brewfile=$HOME/Brewfile
  dotfiles_config_get_path homebrew.brewfile 2>/dev/null && brewfile=$REPLY
  case "$1" in
    install | i | uninstall | remove | rm)
      command brew "$@" || return
      command brew bundle dump --force --file="$brewfile"
      echo "Brewfile has been updated: $brewfile"
      ;;
    *)
      command brew "$@"
      ;;
  esac
}
