#!/usr/bin/python3
"""Return the passphrase only to ssh-add through SSH_ASKPASS."""
import json
import os
from pathlib import Path
import shutil
import sys

config = Path(__file__).resolve().parent.parent / 'config/agent-signing/settings.json'
reference = json.loads(config.read_text())['passphrase_reference']
op = shutil.which('op')
if not op:
    op = next((str(path) for path in [Path('/opt/homebrew/bin/op'), Path('/usr/local/bin/op')]
               if path.is_file()), None)
if not op:
    sys.exit('1Password CLI is not installed')
os.execv(op, [op, 'read', '--no-newline', reference])
