#!/usr/bin/python3
"""Load the coding signing key once, using 1Password as ssh-add's askpass."""
import fcntl
import os
from pathlib import Path
import socket
import stat
import subprocess
import sys
import time

ROOT = Path.home()
SOCKET_DIR = ROOT / '.ssh/agent-signing'
SOCKET = SOCKET_DIR / 'agent.sock'
KEY = ROOT / '.ssh/coding-agent-git-signing-key'
ASKPASS = ROOT / '.local/bin/git-signing-passphrase'


def main():
    if sys.argv[1:] not in ([], ['--login']):
        raise RuntimeError('Usage: git-agent-unlock [--login]')
    os.umask(0o077)
    SOCKET_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    SOCKET_DIR.chmod(0o700)
    with (SOCKET_DIR / 'unlock.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(str(SOCKET))
        except FileNotFoundError:
            start_agent = True
        except ConnectionRefusedError:
            if not stat.S_ISSOCK(SOCKET.lstat().st_mode):
                raise RuntimeError('Unexpected file at the agent socket path')
            SOCKET.unlink()
            start_agent = True
        else:
            start_agent = False
        finally:
            probe.close()
        if start_agent:
            subprocess.run(
                ['/usr/bin/ssh-agent', '-s', '-a', str(SOCKET)],
                stdout=subprocess.DEVNULL, check=True,
            )
        if not KEY.is_file():
            raise RuntimeError('Export the encrypted signing key from 1Password to ' + str(KEY))
        env = os.environ.copy()
        env['SSH_AUTH_SOCK'] = str(SOCKET)
        fingerprint = subprocess.run(
            ['/usr/bin/ssh-keygen', '-l', '-f', str(KEY) + '.pub'],
            capture_output=True, text=True, check=True,
        ).stdout.split()[1]
        identities = subprocess.run(
            ['/usr/bin/ssh-add', '-l'], env=env,
            capture_output=True, text=True,
        )
        if identities.returncode == 0 and any(
            len(parts) > 1 and parts[1] == fingerprint
            for parts in (line.split() for line in identities.stdout.splitlines())
        ):
            print('Coding signing key is already loaded.')
            return
        if '--login' in sys.argv:
            subprocess.run(
                ['/usr/bin/open', '-gj', '-a', '/Applications/1Password.app'],
                check=True,
            )
            time.sleep(5)
        env['SSH_ASKPASS'] = str(ASKPASS)
        env['SSH_ASKPASS_REQUIRE'] = 'force'
        # The passphrase goes from op to ssh-add over the askpass pipe only.
        subprocess.run(
            ['/usr/bin/ssh-add', str(KEY)], env=env,
            stdin=subprocess.DEVNULL, check=True,
        )
        print('Coding signing key loaded without a time limit.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('Could not load the coding signing key: ' + str(error), file=sys.stderr)
        sys.exit(1)
