#!/bin/zsh -f
# Coding agent の署名鍵を 1Password から読み、標準の SSH エージェントに読み込む。
# 秘密鍵はディスクに書かず、op read から ssh-add へ直接渡す。
# 公開鍵は Git の user.signingkey が参照するので ~/.ssh に書き出す。
#   git-agent-unlock          手動で読み込む
#   git-agent-unlock --login  ログイン時の LaunchAgent から呼ぶ (先に 1Password を起動する)
set -eu -o pipefail

item='op://Private/fazqcsykg7yxfudwhlry4v62e4'
pub=~/.ssh/coding-agent-git-signing-key.pub

# 呼び出し元が 1Password の SSH エージェントを指していても、launchd の標準のエージェントに読み込む
export SSH_AUTH_SOCK=$(launchctl getenv SSH_AUTH_SOCK)

if ssh-add -T "$pub" 2>/dev/null ; then
  echo 'Coding signing key is already loaded.'
  exit 0
fi

if [[ ${1:-} == --login ]] ; then
  open -gj -a 1Password
  sleep 5
fi
mkdir -p ~/.ssh
# 一時ファイルに書いてから置き換える (失敗しても今のファイルを壊さず、古いシンボリックリンクも置き換える)
op read "$item/public key" > "$pub.tmp"
mv -f "$pub.tmp" "$pub"
op read "$item/private_key?ssh-format=openssh" | ssh-add -q -
echo 'Coding signing key loaded without a time limit.'
